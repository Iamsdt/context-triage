#################################
###### App Config ###############
#################################
APP_NAME="context-triage"
APP_VERSION="0.1.0"
# Local showcase: development mode keeps the playground and API docs available.
MODE="development"
LOG_LEVEL="INFO"
SUMMARY="context-triage backend"

#################################
###### Cloudflare (Clef) ########
#################################
# Clef runs on Workers AI. The token needs the "Workers AI: Read" permission
# (or a broader Workers AI scope) on this account.
# Without these, context-triage logs a warning and leaves the context untouched.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

#################################
###### API Keys #################
#################################
# Main agent (claude-sonnet-5-5) and the note / fact writer (claude-haiku-5-5).
ANTHROPIC_API_KEY=""
